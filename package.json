{
  "name": "@dothoosh/openclaw-provider",
  "version": "2026.10.5",
  "description": "OpenClaw provider plugin for DotHoosh, an OpenAI and Anthropic compatible AI API gateway (Claude, GPT, Gemini, DeepSeek, Kimi).",
  "type": "module",
  "license": "MIT",
  "author": "Alireza Jalili <alirezajalilii@gmail.com>",
  "homepage": "https://gateway.dothoosh.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alirezajalilii/openclaw-provider-dothoosh.git"
  },
  "bugs": {
    "url": "https://github.com/Alirezajalilii/openclaw-provider-dothoosh/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "provider",
    "dothoosh",
    "llm",
    "gateway"
  ],
  "files": [
    "dist",
    "assets/icon.png",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "sync-manifest": "cp openclaw.plugin.json src/openclaw.plugin.json",
    "build": "npm run sync-manifest && tsc -p tsconfig.build.json && cp openclaw.plugin.json dist/openclaw.plugin.json",
    "test": "npm run sync-manifest && vitest run",
    "typecheck": "npm run sync-manifest && tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openclaw": "2026.10.6",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.5",
      "minGatewayVersion": "2026.10.5"
    },
    "build": {
      "openclawVersion": "2026.10.6",
      "pluginSdkVersion": "2026.10.6"
    }
  }
}
